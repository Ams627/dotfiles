gistimg () {
    local filename="${1:-clipboard.png}"
    local desc="${2:-Public image gist from clipboard}"

    powershell.exe -Command "
      Add-Type -AssemblyName System.Windows.Forms
      \$img = [Windows.Forms.Clipboard]::GetImage()
      if (\$img) {
        \$img.Save('C:\\temp\\clip.png', 'Png')
      } else {
        Write-Error 'No image in clipboard'
      }
    "

    # Check if the image was saved
    if [ -f /c/temp/clip.png ]; then
        gh gist create /c/temp/clip.png -f "$filename" -d "$desc" --public
    else
        echo "❌ No image found in clipboard."
    fi
}


gist-image()
{
    local temp_dir png_windows gist_url gist_id github_user

    temp_dir=$(mktemp -d) || return 1

    png_windows=$(cygpath -w "$temp_dir/clipboard.png") || {
        rm -rf "$temp_dir"
        return 1
    }

    CLIPBOARD_PNG="$png_windows" powershell.exe -NoProfile -STA -Command '
        Add-Type -AssemblyName System.Windows.Forms
        Add-Type -AssemblyName System.Drawing

        $image = [Windows.Forms.Clipboard]::GetImage()

        if ($null -eq $image) {
            Write-Error "The clipboard does not contain an image."
            exit 2
        }

        try {
            $image.Save(
                $env:CLIPBOARD_PNG,
                [Drawing.Imaging.ImageFormat]::Png
            )
        }
        finally {
            $image.Dispose()
        }
    '

    if [[ $? -ne 0 ]]; then
        rm -rf "$temp_dir"
        return 1
    fi

    gist_url=$(
        printf '%s\n' '# Clipboard image' |
            gh gist create \
                --public \
                --desc "Clipboard image" \
                --filename README.md -
    ) || {
        rm -rf "$temp_dir"
        return 1
    }

    gist_id=${gist_url##*/}
    github_user=$(gh api user --jq .login) || {
        rm -rf "$temp_dir"
        return 1
    }

    gh gist clone "$gist_id" "$temp_dir/gist" || {
        rm -rf "$temp_dir"
        return 1
    }

    cp "$temp_dir/clipboard.png" "$temp_dir/gist/clipboard.png"

    printf '# Clipboard image\n\n![Clipboard image](https://gist.githubusercontent.com/%s/%s/raw/clipboard.png)\n' \
        "$github_user" "$gist_id" \
        > "$temp_dir/gist/README.md"

    (
        cd "$temp_dir/gist" &&
        git add README.md clipboard.png &&
        git commit -m "Add clipboard image" &&
        git push
    ) || {
        rm -rf "$temp_dir"
        return 1
    }

    printf '%s' "$gist_url" | clip.exe
    rm -rf "$temp_dir"

    printf 'Created: %s\n' "$gist_url"
    printf 'The URL has been copied to the clipboard.\n'
}




fdiff() {
  git log --pretty=format:'%H%x00%an' |
  awk -F $'\0' '
    NR==1 { author=$2 }
    $2 != author { exit }
    { print $1 }
  ' |
  while read -r commit; do
    git diff-tree --no-commit-id --name-only -r "$commit"
  done | sort -u
}

