    jq -r '
        .clearedBalance as $b |
        "\($b.currency) \(($b.minorUnits / 100) | tostring)"
    '
}

wbal() {
    local TOKEN=1b5f5128-53ca-46e3-9856-74c96da2b1a9
    local PROFILE_ID=8371770
    curl -s "https://api.wise.com/v1/borderless-accounts?profileId=$PROFILE_ID" \
      -H "Authorization: Bearer $TOKEN" |
    jq -r '.[0].balances[]
           | select(.balanceType=="AVAILABLE")
           | "\(.currency)\t\(.amount.value)"'
}

rates()
{
    local token="1b5f5128-53ca-46e3-9856-74c96da2b1a9"

    local gbp=$(curl -s -H "Authorization: Bearer $token" \
        "https://api.wise.com/v1/rates?source=GBP")

    local eur=$(curl -s -H "Authorization: Bearer $token" \
        "https://api.wise.com/v1/rates?source=EUR")

    printf "%-8s %12.6f\n" "GBP/USD" "$(jq -r '.[]|select(.target=="USD")|.rate' <<<"$gbp")"
    printf "%-8s %12.6f\n" "GBP/EUR" "$(jq -r '.[]|select(.target=="EUR")|.rate' <<<"$gbp")"
    printf "%-8s %12.6f\n" "GBP/CZK" "$(jq -r '.[]|select(.target=="CZK")|.rate' <<<"$gbp")"
    printf "%-8s %12.6f\n" "EUR/CZK" "$(jq -r '.[]|select(.target=="CZK")|.rate' <<<"$eur")"
    printf "%-8s %12.6f\n" "EUR/USD" "$(jq -r '.[]|select(.target=="USD")|.rate' <<<"$eur")"
}

f() {
    local path dir

    IFS= read -r -d '' path < /dev/clipboard || :
    [[ -n $path ]] || return 0

    # Remove Windows carriage returns and convert \ to /.
    path=${path//$'\r'/}
    path=${path//\\//}

    # Remove surrounding quotes, if present.
    if [[ $path == \"*\" ]]; then
        path=${path:1:${#path}-2}
    fi

    if [[ -d $path ]]; then
        builtin cd -- "$path"
    elif [[ -f $path ]]; then
        dir=${path%/*}

        # Handle a filename in the current directory or directly under /.
        [[ $dir == "$path" ]] && dir=.
        [[ -n $dir ]] || dir=/

        builtin cd -- "$dir"
    fi
}

CheckIndex() {
    git diff --cached --quiet
    local status=$?

    if (( status == 1 )); then
        echo "Index contains staged changes"
    fi

    return "$status"
}

commitstaged()
{
    local status message

    # Check whether anything is staged.
    git diff --cached --quiet --
    status=$?

    case $status in
        0) return 0 ;;          # Nothing staged: do nothing.
        1) ;;                   # Staged changes exist.
        *) return "$status" ;;  # Git error.
    esac

    if git rev-parse --verify HEAD >/dev/null 2>&1; then
        message="updates"
    else
        message="first commit"
    fi

    git commit -m "$message"
}

cdf()
{
    local pattern=$1
    local -a matches

    mapfile -d '' matches < <(
        find . -mindepth 1 -iname "$pattern" -print0 2>/dev/null
    )

    case ${#matches[@]} in
        0)
            echo "No matches: $pattern" >&2
            return 1
            ;;
        1)
            printf '%s\n' "${matches[0]##*/}"
            if [[ -d ${matches[0]} ]]; then
                cd -- "${matches[0]}"
            else
                cd -- "${matches[0]%/*}"
            fi
            ;;
        *)
            printf 'Multiple matches:\n'
            printf '  %q\n' "${matches[@]}"
            return 2
            ;;
    esac
}

