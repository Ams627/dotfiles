gist2 () {
    if [[ $# -eq 0 ]]; then
        # No args: use clipboard
        local filename="clipboard.txt"
        local desc="Public gist from clipboard"
        cat /dev/clipboard > /c/temp/clip.txt
        gh gist create /c/temp/clip.txt -f "$filename" -d "$desc" --public
    else
        # For each file passed as argument
        for file in "$@"; do
            if [[ -f "$file" ]]; then
                local fname="$(basename "$file")"
                gh gist create "$file" -f "$fname" -d "$fname" --public
            else
                echo "Warning: '$file' is not a file"
            fi
        done
    fi
}


# Usage:
#   gist_screenshot /path/to/image.png                # creates a new secret gist with the image + README.md
#   gist_screenshot /path/to/image.png GIST_ID        # adds image to existing gist and updates README.md
#
# Requires: gh (GitHub CLI) logged in: gh auth login
gist_screenshot() {
  saveclip clipboard.png

  local img="clipboard.png
  "
  if [[ ! -f "$img" ]]; then
    echo "File not found: $img" >&2
    return 2
  fi
  local gist_id="${2:-}"
  local img_name; img_name="$(basename "$img")"
  local alt_text="${img_name%.*}"

  # figure out your GitHub username (for building raw URL)
  local gh_user
  gh_user="$(gh api user -q .login)"

  # Helper: build a raw URL that auto-redirects to latest revision
  # Format: https://gist.githubusercontent.com/<user>/<gist_id>/raw/<filename>
  build_raw_url() {
    local gid="$1"; local fname="$2"
    echo "https://gist.githubusercontent.com/${gh_user}/${gid}/raw/${fname}"
  }

  # Create or update the gist
  if [[ -z "$gist_id" ]]; then
    # Create a new secret gist with the image and a README.md that embeds it
    local tmp_md; tmp_md="$(mktemp)"
    cat > "$tmp_md" <<EOF
# Screenshot

![${alt_text}](${img_name})
EOF
    # Create gist (secret by default). Capture the URL.
    local gist_url
    gist_url="$(gh gist create "$tmp_md" "$img" --desc "Screenshot: ${img_name}" --public=true)"
    gist_id="${gist_url##*/}"  # last path segment is the gist ID
    echo "Created gist: $gist_url"

    # Now rewrite README.md to point to the raw URL (stable across revisions)
    local raw_url; raw_url="$(build_raw_url "$gist_id" "$img_name")"
    local tmp_md2; tmp_md2="$(mktemp)"
    cat > "$tmp_md2" <<EOF
# Screenshot

![${alt_text}](${raw_url})
EOF
    gh gist edit "$gist_id" "$tmp_md2" -f README.md >/dev/null
    rm -f "$tmp_md" "$tmp_md2"

  else
    # Add the image to an existing gist and update/append README.md
    echo "Updating gist: https://gist.github.com/${gist_id}"
    gh gist edit "$gist_id" "$img" -f "$img_name" >/dev/null

    # Try to fetch README.md (if present)
    local readme_tmp; readme_tmp="$(mktemp)"
    if gh api "gists/${gist_id}" -q '.files."README.md".raw_url' >/dev/null 2>&1; then
      local readme_url
      readme_url="$(gh api "gists/${gist_id}" -q '.files."README.md".raw_url')"
      curl -fsSL "$readme_url" -o "$readme_tmp"
    else
      echo "# Screenshots" > "$readme_tmp"
    fi

    # Append the new embedded image using its raw URL
    local raw_url; raw_url="$(build_raw_url "$gist_id" "$img_name")"
    {
      echo
      echo "## ${alt_text}"
      echo
      echo "![${alt_text}](${raw_url})"
    } >> "$readme_tmp"

    gh gist edit "$gist_id" "$readme_tmp" -f README.md >/dev/null
    rm -f "$readme_tmp"
  fi

  # Print the Markdown snippet and copy to clipboard if available
  local final_url; final_url="$(build_raw_url "$gist_id" "$img_name")"
  local snippet="![${alt_text}](${final_url})"
  echo
  echo "Markdown snippet (copied to clipboard if available):"
  echo "$snippet"

  if command -v pbcopy >/dev/null 2>&1; then
    printf "%s" "$snippet" | pbcopy
  elif command -v xclip >/dev/null 2>&1; then
    printf "%s" "$snippet" | xclip -selection clipboard
  elif command -v wl-copy >/dev/null 2>&1; then
    printf "%s" "$snippet" | wl-copy
  fi

  echo
  echo "Gist page: https://gist.github.com/${gist_id}"
}

gff() {
    local s="$1"

    # check if string contains a wildcard
    if [[ "$s" == *[\*\?\[]* ]]; then
        # already a pattern
        git ls-files -- ":(icase,glob)**/$s"
    else
        # plain string, search as substring
        git ls-files -- ":(icase,glob)**/*$s*"
    fi
}

gfff() {
    local s="$1"
    local pattern

    if [[ "$s" == *[\*\?\[]* ]]; then
        pattern=":(icase,glob)**/$s"
    else
        pattern=":(icase,glob)**/*$s*"
    fi

    for f in $(git ls-files -- "$pattern"); do
        echo "${f##*/}"
    done
}

netscan(){
    nmap -sn 192.168.50.0/24
}


pwg() {
    local dir="$PWD"
    local root="/"

    while [[ "$dir" != "$root" ]]; do
        if [[ -e "$dir/.git" ]]; then
            local rel="${PWD#$dir/}"
            if [[ "$rel" == "$PWD" ]]; then
                printf ".\n"
            else
                printf "%s\n" "$rel"
            fi
            return
        fi
        dir="$(dirname "$dir")"
    done

    printf "%s\n" "$PWD"
}


ffstreams()
{
    if [ "$#" -eq 0 ]; then
        echo "Usage: ffstreams <file> [file ...]"
        return 1
    fi

    for file in "$@"; do
        echo "=== $file ==="

        ffprobe -v error \
            -show_entries stream=index,codec_type,codec_name,width,height,channels:stream_tags=language,title \
            -of compact=p=0:nk=1 \
            "$file"

        echo
    done
}

ffcopy()
{
    if [ "$#" -ne 2 ]; then
        echo "Usage: ffcopy <input-file> <output-file>"
        return 1
    fi

    local input="$1"
    local output="$2"

    if [ ! -f "$input" ]; then
        echo "ffcopy: input file not found: $input"
        return 1
    fi

    ffmpeg -i "$input" \
        -map 0 \
        -map_metadata 0 \
        -map_chapters 0 \
        -c copy \
        "$output"
}

ratio()
{
    if [ "$#" -ne 1 ]; then
        echo "Usage: ratio <video-file>"
        return 1
    fi

    local file="$1"

    if [ ! -f "$file" ]; then
        echo "ratio: file not found: $file"
        return 1
    fi

    local dar

    dar=$(ffprobe -v error \
                  -select_streams v:0 \
                  -show_entries stream=display_aspect_ratio \
                  -of default=nw=1:nk=1 \
                  "$file")

    if [ -n "$dar" ] && [ "$dar" != "N/A" ]; then
        echo "$dar"
        return 0
    fi

    ffprobe -v error \
            -select_streams v:0 \
            -show_entries stream=width,height \
            -of csv=p=0:s=x \
            "$file"
}


fiobalance() {
    local token="3jEgq9WrnOW7bpapTf3TN7uzyiwQYFluaNHHm8MUFXfCvGir323rkHvYZycFrYGN"

    curl -s \
    "https://fioapi.fio.cz/v1/rest/periods/$token/$(date +%F)/$(date +%F)/transactions.json" |
    jq -r '.accountStatement.info.closingBalance'
}

fiotx() {
    local token="3jEgq9WrnOW7bpapTf3TN7uzyiwQYFluaNHHm8MUFXfCvGir323rkHvYZycFrYGN"
    local from="${1:-$(date -d '7 days ago' +%F)}"
    local to="${2:-$(date +%F)}"

    echo curl -s "https://fioapi.fio.cz/v1/rest/periods/$token/$from/$to/transactions.json"

    curl -s "https://fioapi.fio.cz/v1/rest/periods/$token/$from/$to/transactions.json" | \
    jq -r '
        .accountStatement.transactionList.transaction[]
        | [
            .column0.value[0:10],
            (.column1.value | tostring),
            (.column8.value // ""),
            (
                .column16.value //
                .column25.value //
                .column10.value //
                ""
            )
        ]
        | @tsv
    ' |
    column -t -s $'\t'
}


